        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>0.2</mu2>
              <slip1>0.0</slip1>
              <slip2>0.08</slip2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>100000.0</kp>
