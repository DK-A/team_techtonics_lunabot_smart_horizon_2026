        <dynamics><damping>0.05</damping><friction>0.05</friction></dynamics>
      </axis>
    </joint>

    <link name="right_middle_wheel">
      <pose relative_to="right_bogie">0.325 -0.050 -0.175 0 0 0</pose>
      <inertial>
        <mass>3.0</mass>
        <pose>0 0 0 0 0 0</pose>
        <inertia>
          <ixx>0.028</ixx><ixy>0.0</ixy><ixz>0.0</ixz>
          <iyy>0.050</iyy><iyz>0.0</iyz>
          <izz>0.028</izz>
        </inertia>
      </inertial>
      <visual name="right_middle_wheel_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh><uri>model://lunabot/meshes/right_middle_wheel.glb</uri></mesh>
        </geometry>
      </visual>
      <collision name="right_middle_wheel_collision">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.1825</radius>
            <length>0.1600</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>0.2</mu2>
              <slip1>0.0</slip1>
              <slip2>0.08</slip2>
            </ode>
