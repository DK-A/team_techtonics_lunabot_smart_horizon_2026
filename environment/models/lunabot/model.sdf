            </ode>
          </friction>
          <contact>
            <ode>
              <kp>100000.0</kp>
              <kd>100.0</kd>
              <min_depth>0.002</min_depth>
              <max_vel>0.05</max_vel>
            </ode>
          </contact>
        </surface>
      </collision>
    </link>

    <joint name="right_front_wheel_joint" type="revolute">
      <parent>right_rocker</parent>
      <child>right_front_wheel</child>
      <pose relative_to="right_front_wheel">0 0 0 0 0 0</pose>
      <axis>
