          <contact>
            <ode>
              <kp>100000.0</kp>
              <kd>100.0</kd>
              <min_depth>0.002</min_depth>
              <max_vel>0.05</max_vel>
            </ode>
          </contact>
        </surface>
      </collision>
    </link>

    <joint name="left_middle_wheel_joint" type="revolute">
      <parent>left_bogie</parent>
      <child>left_middle_wheel</child>
      <pose relative_to="left_middle_wheel">0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
        <dynamics><damping>0.05</damping><friction>0.05</friction></dynamics>
      </axis>
    </joint>

    <link name="left_rear_wheel">
      <pose relative_to="left_bogie">-0.325 0.050 -0.175 0 0 0</pose>
      <inertial>
        <mass>3.0</mass>
        <pose>0 0 0 0 0 0</pose>
        <inertia>
          <ixx>0.028</ixx><ixy>0.0</ixy><ixz>0.0</ixz>
          <iyy>0.050</iyy><iyz>0.0</iyz>
